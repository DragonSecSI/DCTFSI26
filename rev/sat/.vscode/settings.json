    "C_Cpp.default.configurationProvider": "mesonbuild.mesonbuild",
    "C_Cpp.default.compileCommands": "/home/riggle/ctf/2026/dctfsi-2026/modern/builddir/compile_commands.json",
    "C_Cpp.clang_format_style": "Google",
