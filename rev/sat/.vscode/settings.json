{
    "mesonbuild.configureOptions": [
        "--native-file=meson-local-gcc.ini"
    ],
    "mesonbuild.configureEnvironment": {
        "CC": "${workspaceFolder}/build_gcc/bin/bin/gcc",
        "CXX": "${workspaceFolder}/build_gcc/bin/bin/g++",
        "AR": "${workspaceFolder}/build_gcc/bin/bin/gcc-ar",
        "NM": "${workspaceFolder}/build_gcc/bin/bin/gcc-nm",
