encflag :=
 (p (d0 2 3)
 (p (d0 4 3)
 (p (d1 0 3)
 (p (d0 1 8)
 (p (d0 4 6)
 (p (d1 2 1)
 (p (d0 3 9)
 (p (d1 2 1)
 (p (d1 0 5)
 (p (d0 1 2)
 (p (d0 3 9)
 (p (d1 1 1)
 (p (d1 0 3)
 (p (d0 2 0)
 (p (d0 8 6)
 (p (d0 4 1)
 0)))))))))))))))) ;

key := ^ lst .
 (p (d0 5 1)
 (p (d0 7 2)
 (p (d1 1 5)
 (p (d0 4 4)
 lst)))) ;

fullkey := 4 (^ m r . key r) 0 ;

iszero := ^ n . n (^ m r . false) true ;
<= := ^ n m . iszero (- n m) ;
< := ^ n m . <= (succ n) m ;
== := ^ n m . and (<= n m) (<= m n) ;

128 := * 8 (+ 8 8) ;
m128 := ^ a . (< a 128) a (- a 128) ;
+128 := ^ a b . m128 (+ a b) ;


foldlist2 := ^ g x l1 l2 . thd (16
(^ m r .
    (tri
        (ps (fst r))
        (ps (snd r))
        (g (pf (fst r)) (pf (snd r)) (thd r))))
(tri l1 l2 x)) ;

addlist := foldlist2 (^ x y acc . (p (+128 x y) acc)) 0 ;
eqlist := foldlist2 (^ x y acc . (and (== x y) acc)) true ;
revlist := foldlist2 (^ x y acc . (p y acc)) 0 0 ;

test := ^ flag . eqlist encflag (revlist (addlist flag fullkey)) ;

