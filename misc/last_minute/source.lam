tri := ^ x y z . ^ p . p x y z ;
fst := ^ p . p (^ x y z . x) ;
snd := ^ p . p (^ x y z . y) ;
thd := ^ p . p (^ x y z . z) ;

p := ^ x y . ^ p . p x y ;
pf := ^ p . p (^ x y . x) ;
ps := ^ p . p (^ x y . y) ;

0 := ^ f x . x ;
1 := ^ f x . f 0 x ;
2 := ^ f x . f 1 (f 0 x) ;
3 := ^ f x . f 2 (f 1 (f 0 x)) ;
4 := ^ f x . f 3 (f 2 (f 1 (f 0 x))) ;
succ := ^ n . ^ f x . f n (n f x);
pred := ^ n . n (^ m r . m) 0 ;
5 := succ 4 ;
6 := succ 5 ;
7 := succ 6 ;
8 := succ 7 ;
9 := succ 8 ;
10 := succ 9 ;
true := ^ x y . x ;
false := ^ x y . y ;
and := ^ a b . a b a ;
:constant Z
:constant S
show := ^ n . n (^ m r . S r) Z ;
+ := ^ n k . n (^ m r . succ r) k ;
* := ^ n k . n (^ m r . + k r) 0 ;
- := ^ n k . k (^ m r . pred r) n ;
d0 := ^ i j . + (* i 10) j ;
100 := * 10 10 ;
16 := * 4 4 ;
d1 := ^ i j . + (d0 i j) 100 ;

